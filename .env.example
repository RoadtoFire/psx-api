SECRET_KEY=your-secret-key-here
DEBUG=True
DATABASE_URL=postgres://user:password@localhost:5432/dbname
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.amanat-psx.com
CRON_SECRET=your-cron-secret-here
# Optional — Twilio WhatsApp dividend notifications. Leave blank to disable (notifications just won't send, no crash).
TWILIO_ACCOUNT_SID=
# Optional — paired with TWILIO_ACCOUNT_SID above.
TWILIO_AUTH_TOKEN=
# Optional — your Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (sandbox) or whatsapp:+1XXXXXXXXXX (production).
TWILIO_WHATSAPP_FROM=

# Google OAuth — "Continue with Google" on login/register.
# Get from: console.cloud.google.com → Credentials → OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=

# Password reset emails via Resend (resend.com — 3000/month free).
RESEND_API_KEY=
# Sender address. Use onboarding@resend.dev to start; then verify amanat-psx.com domain for noreply@amanat-psx.com.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Full URL of the frontend — included in password reset links.
FRONTEND_URL=https://www.amanat-psx.com
